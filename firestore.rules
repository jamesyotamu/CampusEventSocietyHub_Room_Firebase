rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && (request.auth.token.admin == true || (userExists() && userDoc().role == 'ADMIN') || request.auth.token.email == 'admin@campus.local'); }
    function isOrganiser() { return signedIn() && (request.auth.token.organiser == true || (userExists() && userDoc().role == 'ORGANISER')); }
    function accountActive() { return signedIn() && (!userExists() || userDoc().active == true); }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (request.resource.data.role == 'STUDENT' || request.resource.data.role == 'ADMIN')
        && request.resource.data.active == true;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && (isAdmin() || (request.auth.uid == uid && request.resource.data.role == resource.data.role));
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn() && (isAdmin() || isOrganiser())
        && request.resource.data.organiserUid == request.auth.uid;
      allow update, delete: if signedIn() && (isAdmin() ||
        (isOrganiser() && resource.data.organiserUid == request.auth.uid));
    }

    match /organiserApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow read: if signedIn();
      allow update: if signedIn() && isAdmin();
      allow delete: if false;
    }

    match /registrations/{registrationId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid;
      allow delete: if signedIn() && (isAdmin() || resource.data.studentUid == request.auth.uid);
      allow update: if false;
    }
  }
}
